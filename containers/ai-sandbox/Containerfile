# AI Sandbox Container
# Isolated environment for running AI coding agents (Claude Code, Codex, Gemini CLI)
# with full code access but no host secrets.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    nodejs \
    npm \
    python3 \
    python3-pip \
    golang-go \
    make \
    jq \
    ripgrep \
    fd-find \
    && rm -rf /var/lib/apt/lists/*

# AI CLI tools installed globally via npm
RUN npm install -g \
    @anthropic-ai/claude-code \
    @openai/codex \
    @google/gemini-cli

# Non-root user (UID mapped via --userns=keep-id at runtime)
RUN useradd -m -s /bin/bash sandbox

WORKDIR /workspace
USER sandbox
CMD ["/bin/bash"]

#!/usr/bin/env bash
# webcam-enhance — GPU-accelerated webcam enhancement via GStreamer + VA-API.
#
# Reads from a physical webcam, applies noise reduction and sharpening on the
# AMD GPU via vaapipostproc, and outputs to a v4l2loopback virtual camera.
# Applications see the virtual camera as "Enhanced Webcam".
#
# All parameters are configurable via environment variables (useful for
# overriding in the systemd service or on the command line).
#
# Usage:
#   bin/webcam-enhance                              # defaults
#   WEBCAM_SRC=/dev/video2 bin/webcam-enhance       # custom source camera

set -euo pipefail

# Configuration
WEBCAM_SRC="${WEBCAM_SRC:-/dev/video0}"
WEBCAM_SINK="${WEBCAM_SINK:-/dev/video10}"
WEBCAM_WIDTH="${WEBCAM_WIDTH:-1920}"
WEBCAM_HEIGHT="${WEBCAM_HEIGHT:-1080}"
WEBCAM_FRAMERATE="${WEBCAM_FRAMERATE:-30/1}"
WEBCAM_DENOISE="${WEBCAM_DENOISE:-1}"        # vaapipostproc denoise level
WEBCAM_SHARPEN="${WEBCAM_SHARPEN:-0.5}"      # vaapipostproc sharpen (0.0–1.0)

# Validate devices
if [[ ! -e "$WEBCAM_SRC" ]]; then
    echo "ERROR: Source camera not found: ${WEBCAM_SRC}" >&2
    echo "Available video devices:" >&2
    ls /dev/video* 2>/dev/null >&2 || echo "  (none)" >&2
    exit 1
fi

if [[ ! -e "$WEBCAM_SINK" ]]; then
    echo "ERROR: Virtual camera not found: ${WEBCAM_SINK}" >&2
    echo "Is v4l2loopback loaded? Try: sudo modprobe v4l2loopback" >&2
    exit 1
fi

echo "Webcam enhancement pipeline starting:"
echo "  Source:   ${WEBCAM_SRC}"
echo "  Sink:     ${WEBCAM_SINK}"
echo "  Size:     ${WEBCAM_WIDTH}x${WEBCAM_HEIGHT}@${WEBCAM_FRAMERATE}"
echo "  Denoise:  ${WEBCAM_DENOISE}"
echo "  Sharpen:  ${WEBCAM_SHARPEN}"

exec gst-launch-1.0 -e \
    v4l2src device="$WEBCAM_SRC" \
    ! "video/x-raw,width=${WEBCAM_WIDTH},height=${WEBCAM_HEIGHT},framerate=${WEBCAM_FRAMERATE}" \
    ! videoconvert \
    ! vaapipostproc \
        denoise="$WEBCAM_DENOISE" \
        sharpen="$WEBCAM_SHARPEN" \
    ! videoconvert \
    ! v4l2sink device="$WEBCAM_SINK"

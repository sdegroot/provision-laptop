#!/usr/bin/env bash
# bin/apply - Enforce desired state on the system.
#
# Usage: bin/apply [--module <name>]

# Re-exec with Homebrew's bash if running macOS system bash (3.x)
if [[ "${BASH_VERSINFO[0]}" -lt 4 ]]; then
    for _brew_bash in /opt/homebrew/bin/bash /usr/local/bin/bash; do
        if [[ -x "$_brew_bash" ]]; then
            exec "$_brew_bash" "$0" "$@"
        fi
    done
    echo "ERROR: bash 4+ required. Run: brew install bash" >&2
    exit 1
fi

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/../lib/engine.sh"

# Cache sudo credentials upfront so modules don't prompt individually
log_info "Some modules require sudo — authenticating now..."
sudo -v
# Keep sudo alive in the background for the duration of the run
while true; do sudo -n true; sleep 50; kill -0 "$$" || exit; done 2>/dev/null &

log_info "Applying desired state..."
parse_engine_args "apply" "$@"

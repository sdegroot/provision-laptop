#!/usr/bin/env bash
# git-credential-1password — Git credential helper backed by 1Password.
#
# Reads HTTPS credentials from 1Password items via `op read`.
# Configure per-host in .gitconfig:
#
#   [credential "https://git.example.com"]
#       helper = 1password
#       username = myuser
#       op-item = <1password-item-id>
#       op-vault = <vault-name>
#       op-field = credential
#
# Only responds to "get" requests. Ignores "store" and "erase".

set -euo pipefail

[[ "${1:-}" == "get" ]] || exit 0

# Parse input from git
declare -A input
while IFS='=' read -r key value; do
    [[ -n "$key" ]] && input["$key"]="$value"
done

protocol="${input[protocol]:-}"
host="${input[host]:-}"

[[ "$protocol" == "https" && -n "$host" ]] || exit 0

# Read per-host config from git
url="https://$host"
username="$(git config --get "credential.$url.username" 2>/dev/null || true)"
op_item="$(git config --get "credential.$url.op-item" 2>/dev/null || true)"
op_vault="$(git config --get "credential.$url.op-vault" 2>/dev/null || true)"
op_field="$(git config --get "credential.$url.op-field" 2>/dev/null || true)"

[[ -n "$op_item" ]] || exit 0

op_field="${op_field:-credential}"
op_ref="op://${op_vault}/${op_item}/${op_field}"

password="$(op read "$op_ref" 2>/dev/null)" || exit 1

echo "protocol=$protocol"
echo "host=$host"
[[ -n "$username" ]] && echo "username=$username"
echo "password=$password"

#!/bin/sh
# Wrapper for IntelliJ's flatpak terminal: runs the host's zsh via flatpak-spawn.
# IntelliJ's "Shell path" field doesn't support arguments, so this script
# invokes flatpak-spawn --host with the host's login shell.
exec flatpak-spawn --host \
    --env=TERM="${TERM:-xterm-256color}" \
    --env=COLORTERM="${COLORTERM:-truecolor}" \
    /usr/bin/zsh -li "$@"

#!/usr/bin/env bash
# Launch a Brave web app, preventing duplicate windows.
# Usage: brave-app <url> <wm_class>
#
# - Uses the Default profile so sessions/cookies persist across launches
# - Uses a lock file to prevent opening duplicate app windows
# - Lock is cleared automatically when Brave is no longer running
set -euo pipefail

URL="${1:?Usage: brave-app <url> <wm_class>}"
WM_CLASS="${2:?Usage: brave-app <url> <wm_class>}"

LOCK_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/brave-app"
mkdir -p "$LOCK_DIR"
LOCK_FILE="${LOCK_DIR}/${WM_CLASS}.lock"

# Clean ALL stale locks if Brave is not running at all
if ! pgrep -f "/app/brave/brave" > /dev/null 2>&1; then
    rm -f "$LOCK_DIR"/*.lock
fi

# If lock exists, the app window is still open — don't launch a duplicate
if [ -f "$LOCK_FILE" ]; then
    exit 0
fi

touch "$LOCK_FILE"
exec flatpak run com.brave.Browser --profile-directory=Default --app="$URL"

[Unit]
Description=Reset i8042 keyboard controller after resume
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c '\
  sleep 1; \
  echo "i8042: unbinding platform driver..."; \
  echo -n i8042 > /sys/bus/platform/drivers/i8042/unbind 2>/dev/null; \
  sleep 1; \
  echo "i8042: rebinding platform driver..."; \
  echo -n i8042 > /sys/bus/platform/drivers/i8042/bind 2>/dev/null; \
  sleep 2; \
  if grep -rq "KBD" /sys/bus/serio/devices/serio*/description 2>/dev/null; then \
    echo "i8042: keyboard controller reset successfully"; \
  else \
    echo "i8042: WARNING — no keyboard serio device after rebind" >&2; \
    exit 1; \
  fi'

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

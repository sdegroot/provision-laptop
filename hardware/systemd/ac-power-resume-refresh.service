[Unit]
Description=Refresh AC power state after resume (ACPI BIOS workaround)
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
# The BIOS has a broken \_SB.ACDC.RTAC ACPI method that fails on resume,
# causing the kernel to miss the AC adapter state. Poking the power_supply
# uevent forces a re-read from the EC.
ExecStart=/bin/bash -c 'sleep 2; for ps in /sys/class/power_supply/AC*/uevent; do [ -f "$ps" ] && echo change > "$ps"; done'

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
